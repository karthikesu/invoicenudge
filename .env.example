# Copy this file to .env and fill in your own values. Never commit .env.
# Free Groq key (https://console.groq.com/keys). Without it the app uses the built-in rule parser.
GROQ_API_KEY=
# Optional: force a specific Groq model. Leave empty to auto-pick one your key can use.
GROQ_MODEL=
# PayPal SANDBOX only (developer.paypal.com > Apps & Credentials, Sandbox). Never use live credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: PORT=3000
